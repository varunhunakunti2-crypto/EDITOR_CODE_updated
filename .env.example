SECRET_KEY=change-this-to-a-long-random-string
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=90

# Local Stable Diffusion inpainting model (downloaded from Hugging Face on first use)
SD_MODEL_ID=runwayml/stable-diffusion-inpainting
# auto | cuda | cpu
SD_DEVICE=auto

# Optional: only used by the standalone code1_api.py Replicate example
REPLICATE_API_TOKEN=
